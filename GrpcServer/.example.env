# =======================================================
# Variables de Entorno - Servidor gRPC (.NET)
# =======================================================

# Puerto HTTP/2 sin TLS (h2c) para desarrollo y clientes gRPC locales (Node.js)
GRPC_HTTP_PORT=5230

# Puerto HTTP/2 con TLS para herramientas externas (Postman, grpcurl)
GRPC_HTTPS_PORT=7019
