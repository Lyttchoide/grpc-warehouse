# -------------------------------------------------------
# Variables de entorno y secretos
# -------------------------------------------------------
.env
.env.*
*.env
!.example.env
!*.example.env
**/.env
!**/.example.env

# -------------------------------------------------------
# .NET / C#
# -------------------------------------------------------
**/[Bb]in/
**/[Oo]bj/
*.suo
*.user
*.userosscache
*.sln.docstates
.vs/
_ReSharper*/
*.DotSettings.user

# -------------------------------------------------------
# Node.js / npm
# -------------------------------------------------------
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/

# -------------------------------------------------------
# IDEs y Editores
# -------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# -------------------------------------------------------
# Archivos del Sistema Operativo
# -------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
._*
